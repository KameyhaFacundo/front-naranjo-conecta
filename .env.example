VITE_API_URL=http://localhost:8000/api

# Datos de muestra (src/mock.js) en vez de pedirle todo al backend real.
# Por defecto queda en true aunque no esté la variable. Cuando el backend
# esté listo, poner en false acá y en Vercel (y redeployar) — no hace
# falta ningún otro cambio.
VITE_USE_MOCKS=true

# Centro del mapa (coordenadas reales de El Naranjo, Burruyacú, Tucumán).
# Por defecto: centro aproximado del departamento.
VITE_MAPA_LAT=-26.4833
VITE_MAPA_LNG=-64.75
VITE_MAPA_ZOOM=14

# Teléfono del centro de salud de El Naranjo. Vacío = se muestra "a completar".
VITE_TEL_CENTRO_SALUD=

# Número de WhatsApp del chatbot (con código de país, sin espacios ni +,
# ej: 5493865123456). Vacío = el botón flotante del inicio no se muestra.
VITE_WHATSAPP_CHATBOT=
